# Template for the docker-compose .env file. Copy to .env and fill in real
# values:  cp .env.example .env   (the real .env is gitignored).
#
# Generate strong secrets, e.g.:
#   NEARME_AUTH_CLIENT_SECRET:  openssl rand -hex 24
#   NEARME_JWT_SECRET (>=32B):  openssl rand -base64 48

# --- Database ---
POSTGRES_PASSWORD=change-me

# --- Auth (client-credentials JWT) ---
# The Android app's AUTH_CLIENT_SECRET (buildConfigField) MUST equal this.
NEARME_AUTH_CLIENT_SECRET=change-me
# HS256 signing key — must be at least 32 bytes.
NEARME_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
NEARME_JWT_TTL_SECONDS=3600

# --- EIA fuel prices (optional) ---
# Free key from https://www.eia.gov/opendata/ ; leave blank to disable averages.
NEARME_EIA_API_KEY=
NEARME_EIA_DUOAREA=NUS
